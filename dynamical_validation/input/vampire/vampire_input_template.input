create:cylinder

#------------------------------------------
# System Dimensions
#------------------------------------------
dimensions:unit-cell-size-x = 2.72 !A
dimensions:unit-cell-size-y = 2.72 !A
dimensions:unit-cell-size-z = 3.85 !A

dimensions:system-size-x = 4.7 !nm
dimensions:system-size-y = 4.7 !nm
dimensions:system-size-z = 10.0 !nm
dimensions:particle-size = 4.7 !nm
dimensions:particle-spacing = 1.0 !nm

#------------------------------------------
# Material File
#------------------------------------------
material:file=FePtsc6350.mat

#------------------------------------------
#Simulation Attributes:
#------------------------------------------
sim:equilibration-temperature=300
sim:temperature=300
sim:time-steps-increment=100
sim:equilibration-time-steps=200000
sim:total-time-steps=2000000
sim:time-step=1.0E-16
sim:applied-field-strength=10.0 !T
sim:applied-field-unit-vector=0,0,1

#------------------------------------------
# Program and integrator
#------------------------------------------
sim:program=effective-damping
sim:integrator=llg-heun

#------------------------------------------
# Data output
#------------------------------------------
output:real-time
output:applied-field-strength
output:temperature
output:magnetisation
output:material-magnetisation

screen:real-time
screen:magnetisation
screen:applied-field-strength
screen:material-magnetisation
